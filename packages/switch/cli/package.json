{
  "name": "kyora-switch",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Hot-swap Claude Code, Codex, OpenCode, Muse, Grok Build and Antigravity logins between accounts, with live quota for every stored account",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "muse",
    "grok",
    "antigravity",
    "cli",
    "account-switcher",
    "oauth",
    "keychain"
  ],
  "license": "Apache-2.0",
  "author": "Elia Hilse",
  "homepage": "https://kyora.sh",
  "main": "./dist/index.js",
  "bin": {
    "kyora-switch": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify && chmod +x ./dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun --watch src/index.ts",
    "switch": "bun src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@kyora-sh/usage": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "1.4.2",
    "typescript": "^5.9.2"
  }
}
