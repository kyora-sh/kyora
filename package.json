{
  "name": "kyora-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version && bun .github/scripts/release.ts pypi-version-sync && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.8.16",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*/*"
  ]
}
